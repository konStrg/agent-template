# Configuration des requêtes de vérification Oracle (oracle-tester)
# Ne jamais committer de secrets réels : utiliser des références à des
# variables d'environnement externes pour les valeurs sensibles.

# Chaîne de connexion Oracle (host:port/service_name)
ORACLE_CONNECT_STRING=${ORACLE_CONNECT_STRING:-localhost:1521/XEPDB1}

# Identifiants (à surcharger via variables d'environnement réelles,
# jamais en clair ici)
ORACLE_USER=${ORACLE_USER:-}
ORACLE_PASSWORD=${ORACLE_PASSWORD:-}

# Nombre maximum de lignes retournées par une requête de vérification
ORACLE_MAX_ROWS=${ORACLE_MAX_ROWS:-50}

# Requête de vérification par défaut (exemple, en lecture seule)
ORACLE_TEST_QUERY=${ORACLE_TEST_QUERY:-"SELECT table_name FROM user_tables"}

# Timeout (en secondes) pour toute requête exécutée
ORACLE_QUERY_TIMEOUT=${ORACLE_QUERY_TIMEOUT:-10}
