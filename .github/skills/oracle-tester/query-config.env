# Oracle verification query configuration (oracle-tester)
# Never commit real secrets: use references to external environment
# variables for sensitive values.

# Oracle connection string (host:port/service_name)
ORACLE_CONNECT_STRING=${ORACLE_CONNECT_STRING:-localhost:1521/XEPDB1}

# Credentials (to be overridden via real environment variables,
# never in plain text here)
ORACLE_USER=${ORACLE_USER:-}
ORACLE_PASSWORD=${ORACLE_PASSWORD:-}

# Maximum number of rows returned by a verification query
ORACLE_MAX_ROWS=${ORACLE_MAX_ROWS:-50}

# Default verification query (example, read-only)
ORACLE_TEST_QUERY=${ORACLE_TEST_QUERY:-"SELECT table_name FROM user_tables"}

# Timeout (in seconds) for any executed query
ORACLE_QUERY_TIMEOUT=${ORACLE_QUERY_TIMEOUT:-10}
